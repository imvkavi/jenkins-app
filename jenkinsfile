        stage('E2E') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.60.0-noble'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    npm install -g serve
                    server -s build
                    npx playwright test
                '''
            }
        }
            
    }
    }
    post {
        always {
            junit 'test-results/junit.xml'
        }
